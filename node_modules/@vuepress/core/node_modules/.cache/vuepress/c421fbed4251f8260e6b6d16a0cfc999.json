（详细版）.md"],"sourcesContent":["var render = function render() {\n  var _vm = this,\n    _c = _vm._self._c\n  return _c(\n    \"ContentSlotsDistributor\",\n    { attrs: { \"slot-key\": _vm.$parent.slotKey } },\n    [\n      _c(\"h2\", { attrs: { id: \"_0-引言\" } }, [\n        _c(\"a\", { staticClass: \"header-anchor\", attrs: { href: \"#_0-引言\" } }, [\n          _vm._v(\"#\"),\n        ]),\n        _vm._v(\" 0 引言\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"在深度学习的世界中，激活函数是神经网络中不可或缺的组成部分。它们决定了网络的非线性特性，并且对模型的训练和性能起着至关重要的作用。本文将详细介绍激活函数的作用、常见类型及其优缺点，帮助你深入理解激活函数在神经网络中的关键作用。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"_1-激活函数的作用\" } }, [\n        _c(\n          \"a\",\n          {\n            staticClass: \"header-anchor\",\n            attrs: { href: \"#_1-激活函数的作用\" },\n          },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 1 激活函数的作用\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"神经网络由许多神经元（即节点）组成，每个神经元的作用是接受输入，进行计算，然后输出一个结果。在神经网络的基本形式中，每个神经元的计算可以表示为：\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"$$\\ny = f(w_1x_1 + w_2x_2 + \\\\cdots + w_nx_n + b)\\n$$\\n其中，$x_1, x_2, \\\\dots, x_n$ 是输入，$w_1, w_2, \\\\dots, w_n$ 是权重，$b$ 是偏置，$f$ 就是我们要讨论的激活函数。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"_2-为什么需要激活函数\" } }, [\n        _c(\n          \"a\",\n          {\n            staticClass: \"header-anchor\",\n            attrs: { href: \"#_2-为什么需要激活函数\" },\n          },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 2 为什么需要激活函数？\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"blockquote\", [\n        _c(\"p\", [\n          _vm._v(\n            \"激活函数让神经网络能够处理图像识别、语音识别、自然语言处理等任务，因为它赋予了网络表达非线性关系的能力。\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"激活函数的主要作用是引入非线性，使得神经网络能够学习和表示复杂的关系。如果没有激活函数，神经网络仅仅是多个线性变换的堆叠，那么无论有多少层，整个网络等价于一个单层的线性模型，无法处理复杂问题。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h2\", { attrs: { id: \"_3-常见的激活函数\" } }, [\n        _c(\n          \"a\",\n          {\n            staticClass: \"header-anchor\",\n            attrs: { href: \"#_3-常见的激活函数\" },\n          },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 3 常见的激活函数\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"_3-1-sigmoid-函数\" } }, [\n        _c(\n          \"a\",\n          {\n            staticClass: \"header-anchor\",\n            attrs: { href: \"#_3-1-sigmoid-函数\" },\n          },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 3.1 Sigmoid 函数\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\"Sigmoid 函数是最早被使用的激活函数之一，它的公式如下：\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"$$f(x) = \\\\frac{1}{1 + e^{-x}}$$\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"Sigmoid 函数的输出范围在0到1之间，因此常用于二分类任务中的输出层。例如，在二分类的神经网络中，输出层通常会使用 Sigmoid 函数来表示预测的概率。\\n\"\n        ),\n        _c(\"img\", {\n          attrs: {\n            src: require(\"./assets/ca789dc0ca704392a004b775fd5ac0bd.png\"),\n            alt: \"在这里插入图片描述\",\n          },\n        }),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_c(\"strong\", [_vm._v(\"优点：\")])]),\n      _vm._v(\" \"),\n      _c(\"ul\", [\n        _c(\"li\", [_vm._v(\"输出范围限制在 (0, 1) 之间，适用于概率输出。\")]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_c(\"strong\", [_vm._v(\"缺点：\")])]),\n      _vm._v(\" \"),\n      _c(\"ul\", [\n        _c(\"li\", [\n          _vm._v(\n            \"梯度消失问题：当输入值过大或过小时，Sigmoid 的梯度接近0，导致梯度下降时权重更新缓慢，训练变得困难。\"\n          ),\n        ]),\n        _vm._v(\" \"),\n        _c(\"li\", [\n          _vm._v(\"输出不以零为中心，可能导致在训练过程中权重更新的不稳定。\"),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_c(\"strong\", [_vm._v(\"常用场景：\")])]),\n      _vm._v(\" \"),\n      _c(\"ul\", [\n        _c(\"li\", [\n          _vm._v(\n            \"常用于二分类任务中的输出层，如二分类的逻辑回归、神经网络输出。\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"_3-2-tanh-双曲正切-函数\" } }, [\n        _c(\n          \"a\",\n          {\n            staticClass: \"header-anchor\",\n            attrs: { href: \"#_3-2-tanh-双曲正切-函数\" },\n          },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 3.2 Tanh（双曲正切）函数\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"Tanh 函数是 Sigmoid 函数的一个变体，它的输出范围是 (-1, 1)，其公式为：\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"$$f(x) = \\\\frac{e^x - e^{-x}}{e^x + e^{-x}}$$\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"与 Sigmoid 相比，Tanh 函数的优点在于它的输出值是以零为中心的，这使得网络在训练时更为稳定。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _c(\"img\", {\n          attrs: {\n            src: require(\"./assets/231cb7932cfb46d18112d01427308c35.png\"),\n            alt: \"在这里插入图片描述\",\n          },\n        }),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_c(\"strong\", [_vm._v(\"优点：\")])]),\n      _vm._v(\" \"),\n      _c(\"ul\", [\n        _c(\"li\", [_vm._v(\"输出范围为 (-1, 1)，更加平衡，适合深度网络。\")]),\n        _vm._v(\" \"),\n        _c(\"li\", [_vm._v(\"相较于 Sigmoid，梯度消失的问题略微减轻。\")]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_c(\"strong\", [_vm._v(\"缺点：\")])]),\n      _vm._v(\" \"),\n      _c(\"ul\", [\n        _c(\"li\", [\n          _vm._v(\n            \"和 Sigmoid 一样，Tanh 也存在梯度消失问题，尤其是在深层网络中。\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_c(\"strong\", [_vm._v(\"常用场景：\")])]),\n      _vm._v(\" \"),\n      _c(\"ul\", [\n        _c(\"li\", [\n          _vm._v(\n            \"常用于循环神经网络（RNN）和其他需要连续值输出的网络中，特别是在文本生成、序列建模任务中。\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"_3-3-relu-修正线性单元\" } }, [\n        _c(\n          \"a\",\n          {\n            staticClass: \"header-anchor\",\n            attrs: { href: \"#_3-3-relu-修正线性单元\" },\n          },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 3.3 ReLU（修正线性单元）\"),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"ReLU 是目前最常用的激活函数之一，它的公式非常简单：\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [_vm._v(\"$f(x) = \\\\max(0, x)$\")]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _vm._v(\n          \"ReLU 的输出为输入值与 0 的最大值。当输入为负数时，输出为 0；当输入为正数时，输出与输入值相等。\"\n        ),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [\n        _c(\"img\", {\n          attrs: {\n            src: require(\"./assets/0ee03b2402e1466c8f388daf56d5ec35.png\"),\n            alt: \"在这里插入图片描述\",\n          },\n        }),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_c(\"strong\", [_vm._v(\"优点：\")])]),\n      _vm._v(\" \"),\n      _c(\"ul\", [\n        _c(\"li\", [_vm._v(\"计算简单，收敛速度快。\")]),\n        _vm._v(\" \"),\n        _c(\"li\", [_vm._v(\"减少了梯度消失的问题，尤其适用于深度网络。\")]),\n        _vm._v(\" \"),\n        _c(\"li\", [_vm._v(\"在实际应用中，ReLU 通常能够有效地提高网络性能。\")]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_c(\"strong\", [_vm._v(\"缺点：\")])]),\n      _vm._v(\" \"),\n      _c(\"ul\", [\n        _c(\"li\", [\n          _c(\"strong\", [_vm._v(\"死神经元问题\")]),\n          _vm._v(\n            \"：当输入为负值时，ReLU 输出为 0，导致梯度为 0，从而无法进行权重更新。这可能导致一些神经元永远不被激活，影响模型的学习。\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"p\", [_c(\"strong\", [_vm._v(\"常用场景：\")])]),\n      _vm._v(\" \"),\n      _c(\"ul\", [\n        _c(\"li\", [\n          _vm._v(\n            \"广泛应用于卷积神经网络（CNN）、全连接神经网络（FCN）等各类深度神经网络，尤其在图像分类、物体检测等任务中表现优秀。\"\n          ),\n        ]),\n      ]),\n      _vm._v(\" \"),\n      _c(\"h3\", { attrs: { id: \"_3-4-leaky-relu-带泄漏的relu\" } }, [\n        _c(\n          \"a\",\n          {\n            staticClass: \"header-anchor\",\n            attrs: { href: \"#_3-4-leaky-relu-带泄漏的relu\" },\n          },\n          [_vm._v(\"#\")]\n        ),\n        _vm._v(\" 3.4 Leaky ReLU（带泄漏